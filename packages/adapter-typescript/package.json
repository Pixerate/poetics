{
  "name": "@poetics/adapter-typescript",
  "version": "0.6.0",
  "description": "Poetics indexer for TypeScript: detects functions, hooks and types, normalises their syntax trees, hashes signatures and resolves cross-file edges.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/poetics.git",
    "directory": "packages/adapter-typescript"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "poetics-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@poetics/core": "workspace:*",
    "typescript": "^6.0.3"
  }
}
