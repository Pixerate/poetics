{
  "name": "@poetics/adapter-svelte",
  "version": "0.0.0",
  "private": true,
  "description": "Poetics adapter that detects Svelte components and functions in .svelte and .svelte.ts files.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/poetics.git",
    "directory": "packages/adapter-svelte"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "poetics-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@poetics/core": "workspace:*"
  }
}
