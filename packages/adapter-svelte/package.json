{
  "name": "@poetics/adapter-svelte",
  "version": "0.5.0",
  "description": "Poetics adapter that indexes Svelte components through svelte2tsx in the TypeScript indexer's program.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/poetics.git",
    "directory": "packages/adapter-svelte"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "exports": {
    ".": {
      "poetics-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@poetics/adapter-typescript": "workspace:*",
    "svelte2tsx": "0.7.62",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "svelte": "5.57.3"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  }
}
