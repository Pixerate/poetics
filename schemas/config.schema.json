{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poetics.dev/schemas/config.schema.json",
  "title": "Poetics config",
  "description": "Repository configuration at .poetics/config.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "adapters",
    "include"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "react",
          "svelte",
          "typescript"
        ]
      }
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tsconfig": {
          "type": "string",
          "minLength": 1,
          "description": "tsconfig whose compiler options the TypeScript indexer uses, relative to the repository root. Without one, the indexer uses strict nodenext defaults."
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "enum": [
            "flat",
            "sharded"
          ],
          "description": "flat: units/<uid>.json. sharded: units/<first two uid chars>/<uid>.json, for very large monorepos."
        }
      }
    },
    "backfill": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings for poetics backfill (ADR 0011).",
      "properties": {
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "description": "The command backfill --draft runs to draft rationale (ADR 0017). Poetics names no model or provider: the command reads one JSON draft request on stdin and writes one JSON draft on stdout.",
          "properties": {
            "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Program and arguments, run without a shell from the repository root." },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "description": "How long one draft may take before it counts as failed. Default 120." }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireRationale": {
          "type": "boolean"
        },
        "agentRationaleNeedsReview": {
          "type": "boolean"
        },
        "humanSignOffOnAgentInterfaceChanges": {
          "type": "boolean"
        },
        "allowProvisionalHashes": {
          "type": "boolean"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "description": "Minimum ratios (0-1) for `pnpm poetics:coverage`; CI fails when the overall value is lower.",
          "properties": {
            "tracked": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fresh": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "linkedRationale": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reviewed": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "tested": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "documented": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
