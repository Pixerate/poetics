{
  "$schema": "../schemas/config.schema.json",
  "version": 1,
  "adapters": ["typescript", "react", "svelte"],
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts", "evals/fixtures/**/*.{ts,tsx,svelte}"],
  "exclude": ["**/*.test.ts", "**/test-helpers.ts", "**/dist/**", "**/node_modules/**"],
  "store": { "layout": "flat" },
  "policy": {
    "requireRationale": true,
    "agentRationaleNeedsReview": true,
    "humanSignOffOnAgentInterfaceChanges": true,
    "allowProvisionalHashes": true
  }
}
